{
    "name": "Google Sheets Helper",
    "description": "Google Sheets 表格工具，实现配置表管理、比较、合并等功能",
    "filePatterns": {
        "*.gs": {
            "language": "javascript",
            "commentStyle": {
                "lineComment": "//",
                "blockCommentStart": "/**",
                "blockCommentEnd": "*/"
            }
        },
        "*.html": {
            "language": "html",
            "commentStyle": {
                "lineComment": "<!--",
                "blockCommentStart": "<!--",
                "blockCommentEnd": "-->"
            }
        }
    },
    "formatting": {
        "indentSize": 2,
        "insertSpaces": true,
        "maxLineLength": 100
    },
    "linting": {
        "rules": {
            "no-unused-vars": "warn",
            "require-jsdoc": "error",
            "valid-jsdoc": "error"
        }
    },
    "editor": {
        "tabSize": 2,
        "insertSpaces": true,
        "detectIndentation": true,
        "trimTrailingWhitespace": true,
        "insertFinalNewline": true
    },
    "search": {
        "exclude": [
            "node_modules",
            ".git"
        ]
    },
    "jsdoc": {
        "enabled": true,
        "requiredTags": ["param", "returns"],
        "checkTypes": true
    },
    "projectStructure": {
        "src": {
            "description": "Google Apps Script 源代码文件",
            "patterns": ["*.gs", "*.html", "appsscript.json"]
        }
    },
    "conventions": {
        "constants": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "常量使用全大写和下划线命名"
        },
        "classes": {
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "description": "类名使用PascalCase"
        },
        "functions": {
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "description": "函数名使用camelCase"
        },
        "documenation": {
            "description": "使用JSDoc格式注释函数",
            "standard": "每个函数应有描述和参数类型说明"
        },
        "errorHandling": {
            "description": "使用try-catch包装关键函数",
            "logStyle": "console.error记录错误信息"
        },
        "ui": {
            "dialogStyle": "使用HTML对话框+客户端JavaScript",
            "cssFramework": "自定义CSS，无外部依赖"
        },
        "googleServices": {
            "spreadsheetAccess": "SpreadsheetApp",
            "caching": "CacheService",
            "triggers": "ScriptApp"
        }
    },
    "codeStructure": {
        "mainModules": {
            "Code.gs": {
                "description": "包含基础工具函数，如Base64编解码和页签信息获取",
                "functionStyle": "独立函数",
                "responsibility": "基础工具函数"
            },
            "Constants.gs": {
                "description": "定义全局常量和NoteManager类，管理单元格注释",
                "functionStyle": "常量定义+类",
                "responsibility": "常量管理和注释处理"
            },
            "Compare.gs": {
                "description": "实现表格比较功能",
                "functionStyle": "顶级函数",
                "responsibility": "表格对比"
            },
            "Merge.gs": {
                "description": "实现表格合并功能",
                "functionStyle": "顶级函数",
                "responsibility": "表格合并"
            },
            "Triggers.gs": {
                "description": "定义各类触发器和事件处理函数",
                "functionStyle": "事件处理函数",
                "responsibility": "事件处理和触发器管理"
            },
            "IdChecker.gs": {
                "description": "实现ID冲突检查功能",
                "functionStyle": "顶级函数",
                "responsibility": "ID冲突检测"
            }
        },
        "uiComponents": {
            "CompareDialog.html": {
                "description": "表格比较功能的用户界面",
                "format": "HTML+CSS+JavaScript",
                "clientSideLogic": true
            },
            "MergeDialog.html": {
                "description": "表格合并功能的用户界面",
                "format": "HTML+CSS+JavaScript",
                "clientSideLogic": true
            }
        },
        "entryPoints": {
            "onOpen": "创建菜单项并初始化UI",
            "onInstall": "安装触发器",
            "onEdit": "响应表格编辑事件，处理ID检查和单元格标记"
        },
        "patterns": {
            "constants": "使用大写和下划线命名的常量对象",
            "colors": "为不同状态定义颜色常量",
            "noteManagement": "使用NoteManager类管理单元格注释",
            "eventHandling": "使用onEdit触发器响应表格编辑事件"
        },
        "dependencyFlow": {
            "Constants.gs": ["所有其他模块依赖"],
            "Code.gs": ["提供基础功能给其他模块"],
            "Triggers.gs": ["调用Compare.gs、Merge.gs和IdChecker.gs"],
            "Compare.gs": ["使用Constants.gs中的常量"],
            "Merge.gs": ["使用Constants.gs中的常量"],
            "IdChecker.gs": ["使用Constants.gs中的NoteManager"]
        }
    },
    "moduleDependencies": {
        "description": "模块依赖图",
        "root": "Constants.gs和Code.gs",
        "dependents": {
            "Triggers.gs": ["依赖所有功能模块"],
            "Compare.gs": ["依赖Constants.gs"],
            "Merge.gs": ["依赖Constants.gs"],
            "IdChecker.gs": ["依赖Constants.gs"]
        }
    }
}