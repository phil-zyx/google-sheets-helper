{
    "timeZone": "Asia/Shanghai",
    "dependencies": {},
    "exceptionLogging": "STACKDRIVER",
    "runtimeVersion": "V8",
    "oauthScopes": [
        "https://www.googleapis.com/auth/script.scriptapp",
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/script.container.ui",
        "https://www.googleapis.com/auth/script.triggers",
        "https://www.googleapis.com/auth/script.external_request",
        "https://www.googleapis.com/auth/userinfo.email"
    ],
    "addOns": {
        "common": {
            "name": "Google Sheets Helper",
            "logoUrl": "https://writesome.oss-cn-chengdu.aliyuncs.com/logo.jpeg",
            "openLinkUrlPrefixes": [
                "https://www.github.com/",
                "https://script.google.com/"
            ],
            "universalActions": [{
                "label": "Google Sheets Helper",
                "runFunction": "onHomepage"
            }]
        },
        "sheets": {
            "homepageTrigger": {
                "runFunction": "onHomepage"
            },
            "onFileScopeGrantedTrigger": {
                "runFunction": "onFileScopeGranted"
            }
        }
    },
    "urlFetchWhitelist": [
        "https://writesome.oss-cn-chengdu.aliyuncs.com/",
        "https://www.github.com/",
        "https://script.google.com/"
    ]
}